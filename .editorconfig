root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C/C++ firmware
[*.{c,cpp,h,hpp}]
indent_style = space
indent_size = 4

# Python training
[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

# Config files
[*.{json,yaml,yml,toml,ini}]
indent_style = space
indent_size = 2

# Markdown docs
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# KiCad (preservar formato nativo)
[*.kicad_*]
indent_style = space
indent_size = 2
