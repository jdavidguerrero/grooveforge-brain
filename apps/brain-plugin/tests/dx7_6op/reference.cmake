# Explicit local source only; upstream files compile into this oracle executable, never the product.
set(GF_MSFA_REFERENCE_DIR "" CACHE PATH "Read-only MSFA app/src/main/jni for golden tests")
if(EXISTS "${GF_MSFA_REFERENCE_DIR}/dx7note.cc")
    set(oracle_dir "${CMAKE_CURRENT_BINARY_DIR}/msfa-oracle")
    file(MAKE_DIRECTORY "${oracle_dir}")
    foreach(file dx7note env pitchenv lfo freqlut fm_core fm_op_kernel sin exp2 patch)
        configure_file("${GF_MSFA_REFERENCE_DIR}/${file}.h" "${oracle_dir}/${file}.h" COPYONLY)
        configure_file("${GF_MSFA_REFERENCE_DIR}/${file}.cc" "${oracle_dir}/${file}.cc" COPYONLY)
        list(APPEND oracle_sources "${oracle_dir}/${file}.cc")
    endforeach()
    foreach(file controllers.h aligned_buf.h)
        configure_file("${GF_MSFA_REFERENCE_DIR}/${file}" "${oracle_dir}/${file}" COPYONLY)
    endforeach()
    # Select original scalar kernels: historical NEON is an approximation with a different spectrum.
    file(WRITE "${oracle_dir}/synth.h" "#pragma once\n#include <cstdint>\n#include <cstddef>\n#define LG_N 6\n#define N (1 << LG_N)\ntemplate<typename T> inline T min(T a,T b){return a<b?a:b;}\ntemplate<typename T> inline T max(T a,T b){return a>b?a:b;}\ninline bool hasNeon(){return false;}\n")
    add_executable(gf_dx7_6op_reference tests/dx7_6op/reference_compare.cpp ${oracle_sources})
    target_include_directories(gf_dx7_6op_reference PRIVATE "${oracle_dir}")
    target_link_libraries(gf_dx7_6op_reference PRIVATE gf_dx7_6op)
    target_compile_options(gf_dx7_6op_reference PRIVATE -fwrapv)
    add_test(NAME dx7_6op_msfa COMMAND gf_dx7_6op_reference "${CMAKE_CURRENT_BINARY_DIR}/dx7-6op-golden")
endif()
