[Unit]
Description=GrooveForge headless synth host
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=notify
ExecStart=%h/.local/bin/gf-synth-host --backend pipewire
Restart=on-failure
RestartSec=2
WatchdogSec=10
TimeoutStartSec=15
TimeoutStopSec=5
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
