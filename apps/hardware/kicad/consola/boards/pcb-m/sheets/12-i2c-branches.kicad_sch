  (text "D21: TCA9517ADGK library graphic/pins = NXP PCA9517ADP C80799 (MSOP8). VCCA=VCCB=3.3V."
    (at 15.24 20.32 0)
    (effects
      (font
        (size 1.0 1.0))
      (justify left))
    (uuid 588818b1-f33f-51f5-a262-663705e271b2))
  (text "A=local bus shared; B_K and B_A separate cables. NEVER connect two B sides. EN changes only while idle."
    (at 15.24 24.13 0)
    (effects
      (font
        (size 1.0 1.0))
      (justify left))
    (uuid 1783aee5-d953-53b3-8d81-dbf8aa3bcd3a))
  (text "D30: EN_K=Teensy0, EN_A=Teensy1; separate 10k pull-ups / GPIO jumpers. Change EN only with bus idle."
    (at 15.24 27.94 0)
    (effects
      (font
        (size 1.0 1.0))
      (justify left))
    (uuid b681d685-223f-599a-a723-43f680d30930))
  (text "47 ohm 0805 series per cable line; replace with 0 ohm only after measuring VOL/rise time."
    (at 15.24 31.75 0)
    (effects
      (font
        (size 1.0 1.0))
      (justify left))
    (uuid 74d1a4df-2662-5fe9-b9ee-49b9f043038c))
  (text "USBLC6-2SC6 C7519: 3.5pF max per line; short GND return near cable connector. PCB-A I2C only via J2."
    (at 15.24 35.56 0)
    (effects
      (font
        (size 1.0 1.0))
      (justify left))
    (uuid ac7555dd-cee3-54b4-a3ea-2a008452a10c))
  (text "Pull-ups per segment: 2.2k closed / 4.7k open. Remote pull-ups DNP. No MIDI harness or panel holes."
    (at 15.24 39.37 0)
    (effects
      (font
        (size 1.0 1.0))
      (justify left))
    (uuid 7c5efcff-3e60-547b-ba1a-276f417352e6)))
