	(text "NOTAS TEENSY 4.1 (D2):\\nMódulo Audio Shield Rev D en zócalos J_T41L/J_T41R (montaje tipo shield lado a lado, no apilado)\\nSGTL5000 en el shield — I2S 7/8/20/21/23 y I2C 18/19 pasan por el socket\\nCortar puente VUSB-VIN en la Teensy; alimentar desde USB-A del Pi (separado del rail de LEDs)\\nSin microSD SPI (pines 10/11/12/13 son superficie); no montar pot opcional del shield en pin 15\\nHP_VGND = tierra virtual SGTL5000 (~1.65 V) — NUNCA conectar a GND ni al chasis; jack plástico aislado\\nJ_SHIELD_AUDIO: representación del header J9 del Audio Shield (LINE IN L/R + LINE OUT L/R)\\nJ_SHIELD_HP: header del sleeve del jack HP del shield (L, R, VGND)\""
		(exclude_from_sim no)
		(at 20 150 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "bcafea19-2e17-4ff4-bcbe-be6417cdecb3")
	)
